{
  "name": "@tiximax/design-system",
  "version": "1.0.0",
  "description": "Tiximax brand design system — tokens, typography, and UI components",
  "module": "dist/index.es.js",
  "main": "dist/index.cjs.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "node serve.mjs",
    "serve": "node serve.mjs",
    "build": "node build.mjs && tsc --emitDeclarationOnly --outDir dist"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
